# ===== SmartFlow AI environment configuration =====
# Copy backend/.env.example and frontend/.env.example, fill in real values.
# Never commit real secrets.

# ---------- Backend (backend/.env) ----------
PORT=5000
NODE_ENV=development

# Supabase Postgres connection string:
# Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ---------- Emergency response: routing & mapping providers ----------
# Mapping tiles (OpenStreetMap), geocoding (Nominatim), hospital search
# (Overpass) and routing (OSRM) are free and keyless by default.
ROUTING_PROVIDER=osrm            # osrm | mapbox
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api
OVERPASS_USER_AGENT=SmartFlowAI/1.0 (traffic management demo)
PROVIDER_TIMEOUT_MS=8000

# Mapbox alternative (optional). Set ROUTING_PROVIDER=mapbox and add a token
# from https://account.mapbox.com/ to use Mapbox Directions with traffic data.
MAPBOX_TOKEN=

# ---------- Emergency response: optional live traffic provider ----------
# TomTom Traffic Flow API gives live congestion data for the map. Without a
# key the UI shows a clear "live traffic unavailable" notice instead of
# inventing traffic conditions.
TRAFFIC_PROVIDER=none           # none | tomtom
TOMTOM_KEY=

# ---------- Emergency response: signal priority safety ----------
# PHYSICAL traffic-light control. Stays false everywhere in development.
# Only an authorized, certified integration may set this to true.
SIGNAL_ACTUATION_ENABLED=false
EMERGENCY_YELLOW_SECONDS=4
EMERGENCY_ALL_RED_SECONDS=2
EMERGENCY_MIN_GREEN_SECONDS=30
HOSPITAL_RADIUS_M=8000

# ---------- Frontend (frontend/.env) ----------
# VITE_SITE_URL=https://your-domain.com   (canonical/OG tags; empty for localhost)
VITE_SITE_URL=
VITE_API_URL=http://localhost:5000
